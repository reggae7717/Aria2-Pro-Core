LIBSSH2_BUILD() {
    mkdir -p $BUILD_DIR/libssh2 && cd $BUILD_DIR/libssh2
    curl -Ls -o - "$LIBSSH2" | tar jxvf - --strip-components=1
    CPPFLAGS="-I$PREFIX/include ${CPPFLAGS:-}" \
    LDFLAGS="-L$PREFIX/lib -L$PREFIX/lib64 ${LDFLAGS:-}" \
    ./configure \
        --host=$HOST \
        --prefix=$PREFIX \
        --enable-static \
        --disable-shared \
        --disable-examples-build \
        --with-crypto=openssl
    make -j$(nproc)
    make install
}

