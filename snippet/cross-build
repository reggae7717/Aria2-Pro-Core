ARIA2_BUILD() {
    ARIA2_CODE_GET
    if [ "${ARIA2_BUILD_SYSTEM:-autotools}" = "cmake" ]; then
        ARIA2_CMAKE_BUILD
        return
    fi
    ./configure \
        --host=$HOST \
        --build=$(dpkg-architecture -qDEB_BUILD_GNU_TYPE) \
        --prefix=${ARIA2_PREFIX:-'/usr/loacl'} \
        --with-libz \
        --with-libcares \
        --with-libexpat \
        --without-libxml2 \
        --without-libgcrypt \
        --with-openssl \
        --without-libnettle \
        --without-gnutls \
        --without-libgmp \
        --with-libssh2 \
        --with-sqlite3 \
        --without-jemalloc \
        --with-ca-bundle='/etc/ssl/certs/ca-certificates.crt' \
        ARIA2_STATIC=yes \
        --disable-shared
    make -j$(nproc)
}

ARIA2_CMAKE_BUILD() {
    local generator="${ARIA2_CMAKE_GENERATOR:-}"
    local jobs="${JOBS:-$(nproc)}"
    local build_type="${ARIA2_CMAKE_BUILD_TYPE:-Release}"
    local build_dir="${ARIA2_CMAKE_BUILD_DIR:-$ARIA2_CODE_DIR/build/core}"
    local pkg_config_path="$PREFIX/lib/pkgconfig:$PREFIX/lib64/pkgconfig"
    local processor="${ARIA2_CMAKE_PROCESSOR:-$ARCH}"
    local cmake_args=(
        -S "$ARIA2_CODE_DIR"
        -B "$build_dir"
        -D "CMAKE_BUILD_TYPE=$build_type"
        -D "CMAKE_INSTALL_PREFIX=${ARIA2_PREFIX:-/usr/local}"
        -D CMAKE_SKIP_RPATH=ON
        -D "CMAKE_PREFIX_PATH=$PREFIX"
        -D CMAKE_SYSTEM_NAME=Linux
        -D "CMAKE_SYSTEM_PROCESSOR=$processor"
        -D ARIA2_STATIC_DEPENDENCIES=ON
        -D "CMAKE_EXE_LINKER_FLAGS=-static -L$PREFIX/lib -L$PREFIX/lib64"
        -D "CMAKE_FIND_LIBRARY_SUFFIXES=.a"
        -D ARIA2_ENABLE_SSL=ON
        -D ARIA2_ENABLE_BITTORRENT=ON
        -D ARIA2_ENABLE_METALINK=ON
        -D ARIA2_ENABLE_WEBSOCKET=ON
        -D ARIA2_WITH_OPENSSL=ON
        -D ARIA2_WITH_EXPAT=ON
        -D ARIA2_WITH_CARES=ON
        -D ARIA2_WITH_SQLITE3=ON
        -D ARIA2_WITH_LIBSSH2=ON
    )

    if [ -z "$generator" ]; then
        if command -v ninja >/dev/null 2>&1; then
            generator="Ninja"
        elif command -v samu >/dev/null 2>&1; then
            generator="Samurai"
        else
            generator="Unix Makefiles"
        fi
    fi
    cmake_args+=( -G "$generator" )

    PKG_CONFIG_PATH="$pkg_config_path${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
        PKG_CONFIG_LIBDIR="$pkg_config_path" \
        cmake "${cmake_args[@]}"
    cmake --build "$build_dir" --target aria2-next --parallel "$jobs"
    ARIA2_BINARY_PATH="$build_dir/aria2-next"
    test -x "$ARIA2_BINARY_PATH"
}
